# MemMatch — шаблон окружения. Скопируй в .env и заполни.
# Значения — из дашборда Supabase (Project Settings → API) или Management API api-keys.

# Публичные (можно в фронтенд, попадают в бандл)
MEMMATCH_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / sb_publishable_...>

# Серверный (парсер, миграции, загрузка картинок в Storage). НИКОГДА не во фронтенд.
MEMMATCH_SUPABASE_SERVICE_KEY=<service_role / sb_secret_...>
MEMMATCH_SUPABASE_ANON_KEY=<anon / sb_publishable_...>

# Для миграций по Management API (Personal Access Token из дашборда, sbp_...)
SUPABASE_ACCESS_TOKEN=<sbp_...>
MEMMATCH_PROJECT_REF=<ref>
